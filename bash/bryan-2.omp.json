{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "blue-bell": "#9aa5ce",
    "blue-black": "#565f89",
    "celeste-blue": "#b4f9f8",
    "light-sky-blue": "#87CEFA",
    "main-bg": "#24283b",
    "pastal-grey": "#cfc9c2",
    "pistachio-green": "#9ece6a",
    "t-background": "p:main-bg",
    "terminal-black": "#414868",
    "terminal-blue": "#82E6FF",
    "terminal-green": "#75C2B3",
    "terminal-magenta": "#948AE3",
    "terminal-red": "#F97BB0",
    "terminal-white": "#c0caf5",
    "terminal-yellow": "#D7C781",
    "white-blue": "#a9b1d6"
  },
  "console_title_template": " {{ .Folder }} :: {{if .Root}}Admin{{end}}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none",
            "style": "folder"
          },
          "template": "{{ .Path }} ",
          "foreground": "p:terminal-blue",
          "type": "path",
          "style": "plain"
        },
        {
          "properties": {
            "branch_icon": "",
            "cache_duration": "none",
            "fetch_status": true
          },
          "template": "<p:terminal-green>git(</>{{ .HEAD}}<p:terminal-green>)</>",
          "foreground": "p:light-sky-blue",
          "type": "git",
          "style": "plain",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:terminal-red{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0)}}p:light-sky-blue {{ end }}",
            "{{ if gt .Ahead 0 }}p:terminal-blue{{ end }}",
            "{{ if gt .Behind 0 }}p:celeste-blue{{ end }}"
          ]
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "➜",
          "foreground": "p:terminal-blue",
          "background": "p:transparent",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ],
  "version": 3,
  "final_space": true
}
